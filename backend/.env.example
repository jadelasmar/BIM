# Copy this file to `.env` (same directory, next to manage.py) and fill in
# real values for this machine. `.env` is gitignored - never commit it.

# Generate a fresh one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=changeme-generate-a-real-secret-key

# False for LAN/production deployment. Set True on your own machine for local dev.
DJANGO_DEBUG=False

# Comma-separated, no spaces. Must include every hostname/IP this server
# will be reached by, e.g. localhost,127.0.0.1,192.168.1.100
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
