{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opusplan",
  "effortLevel": "high",
  "initialPermissionMode": "acceptEdits",
  "allowedTools": [
    "Bash",
    "PowerShell",
    "Edit",
    "Write",
    "Read",
    "Glob",
    "Grep"
  ],
  "permissions": {
    "ask": [
      "Bash(python manage.py flush:*)",
      "Bash(python manage.py migrate * zero)",
      "Bash(python manage.py dbshell:*)",
      "Bash(python manage.py shell:*)",
      "Bash(dropdb:*)",
      "Bash(rm -rf:*)",
      "PowerShell(Remove-Item*-Recurse*)",
      "PowerShell(Remove-Item*-Force*)"
    ]
  }
}